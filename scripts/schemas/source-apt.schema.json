{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deb-src repositories",
  "description": "Where the source packages of the image's apt packages are published (scripts/source-apt.yaml).",
  "type": "object",
  "required": ["repositories"],
  "additionalProperties": false,
  "properties": {
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": ["name", "url", "suites", "components", "signedBy"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Short name. Documentation only.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "url": { "description": "Repository URL for deb-src.", "type": "string", "pattern": "^https://" },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "signedBy": {
          "description": "Keyring that signs the repository, as a path in the image.",
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
